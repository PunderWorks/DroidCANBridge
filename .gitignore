# PlatformIO build artifacts
.pio/

# Generated by the PlatformIO/ESP-IDF component manager during builds
src/idf_component.yml

# Code coverage reports (scripts/coverage.sh)
coverage/

# Third-party libraries (install instructions in README.md)
lib/*
!lib/README.md

# macOS metadata
.DS_Store

# VSCode
.vscode/
*.code-workspace

# Claude Code internal state
.claude/

# Python files
*.pyc

# KiCad files

# Temporary files
PCB/*.000
PCB/*.bak
PCB/*.bck
PCB/*.kicad_pcb-bak
PCB/*.kicad_sch-bak
PCB/*-backups
PCB/*-cache*
PCB/*-bak
PCB/*-bak*
PCB/*~
PCB/~*
PCB/_autosave-*
PCB/\#auto_saved_files\#
PCB/*.tmp
PCB/*-save.pro
PCB/*-save.kicad_pcb
fp-info-cache
~*.lck

# Netlist files (exported from Eeschema)
PCB/*.net

# Autorouter files (exported from Pcbnew)
PCB/*.dsn
PCB/*.ses

# Exported BOM files
PCB/**/*.xml
PCB/**/*.csv
!PCB/production/bom/*.csv

# Archived Backups (KiCad 6.0)
PCB/**/*-backups/*.zip

# Local git-based history (KiCad 9.0+)
PCB/.history

# Local project settings
PCB/*.kicad_prl

# Production reports
PCB/production/misc/*

# Stackup: library cache, local library override, Cargo build output
.stackup/
manifest.local.kdl
ci/stackup/target/

# Large ST reference documents (RM0490, AN2606): kept locally, not committed. Their source URLs,
# revisions and SHA-256 are in PCB/datasheets/manifest.json.
PCB/datasheets/RM0490.*
PCB/datasheets/AN2606.*

# Manufacturer 3D models that can't be redistributed (download steps in
# PCB/libraries/3dmodels/README.md)
PCB/libraries/3dmodels/WAGO_*.stp
PCB/libraries/3dmodels/*.zip
